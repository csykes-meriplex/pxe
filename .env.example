# Copy this file to .env and fill in your values

# IP of the Docker host on the PXE network (this machine)
DOCKER_HOST_IP=192.168.1.10

# DHCP range to hand out (must not overlap with your router's DHCP range)
DHCP_RANGE_START=192.168.1.100
DHCP_RANGE_END=192.168.1.200
SUBNET_MASK=255.255.255.0
LEASE_TIME=12h

# Your router (default gateway for PXE clients)
GATEWAY_IP=192.168.1.1

# DNS server for PXE clients
DNS_SERVER=192.168.1.1

# IP of your Windows Server (used by copy scripts, not by Docker)
MDT_SERVER_IP=192.168.1.20
