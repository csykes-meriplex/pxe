#!ipxe

# -----------------------------------------------------------------------
# Edit this variable to match your environment
# -----------------------------------------------------------------------
set base-url  http://DOCKER_HOST_IP
# -----------------------------------------------------------------------

set menu-timeout 30000
set menu-default localboot

:start
menu PXE Boot -- ${hostname} (${ip})
item --gap --                         ---- Windows ----
item --key w windows                  [W] Windows (MDT deployment)
item --gap --                         ---- Linux ----
item --key u ubuntu-2204              [U] Ubuntu 22.04 LTS
item --key d debian-12                [D] Debian 12 Bookworm
item --gap --                         ---- Tools ----
item --key l localboot                [L] Boot from local disk
item --key s shell                    [S] iPXE shell
choose --timeout ${menu-timeout} --default ${menu-default} target && goto ${target} || goto localboot

# -----------------------------------------------------------------------
# Windows — wimboot loads LiteTouchPE directly; no WDS required.
# Files live in tftp/windows/ on the Docker host (served via nginx).
# Use scripts/copy-mdt-files.ps1 + scripts/pull-mdt-files.sh to populate.
# -----------------------------------------------------------------------
:windows
  echo Loading Windows PE (MDT) via wimboot...
  kernel ${base-url}/windows/wimboot
  initrd ${base-url}/windows/BCD                      BCD
  initrd ${base-url}/windows/boot.sdi                 boot.sdi
  initrd ${base-url}/windows/LiteTouchPE_x64.wim      boot.wim
  boot || goto boot-failed

# -----------------------------------------------------------------------
# Linux — kernel and initrd served directly from nginx
# Add distro files under tftp/linux/<distro>/ on the Docker host
# -----------------------------------------------------------------------
:ubuntu-2204
  echo Loading Ubuntu 22.04 LTS installer...
  kernel ${base-url}/linux/ubuntu-22.04/vmlinuz \
    root=/dev/ram0 \
    initrd=initrd \
    auto-install/enable=true \
    priority=critical \
    url=${base-url}/linux/ubuntu-22.04/preseed.cfg
  initrd ${base-url}/linux/ubuntu-22.04/initrd
  boot || goto boot-failed

:debian-12
  echo Loading Debian 12 Bookworm installer...
  kernel ${base-url}/linux/debian-12/vmlinuz \
    root=/dev/ram0 \
    initrd=initrd.gz \
    auto=true \
    url=${base-url}/linux/debian-12/preseed.cfg
  initrd ${base-url}/linux/debian-12/initrd.gz
  boot || goto boot-failed

# -----------------------------------------------------------------------
:localboot
  echo Booting from local disk...
  exit 1

:shell
  echo Type 'exit' to return to the menu.
  shell
  goto start

:boot-failed
  echo
  echo Boot failed. Is the target server reachable?
  echo Press any key to return to the menu...
  prompt
  goto start
